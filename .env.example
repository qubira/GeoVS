# Neon (Postgres serverless) — connection strings
# Ve a tu proyecto en https://console.neon.tech > Connection Details
#
# DATABASE_URL: connection string "pooled" (usa el pooler de Neon, recomendado
# para el runtime serverless de Next.js / Vercel).
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require"

# DATABASE_URL_UNPOOLED: connection string directa (sin pooler), usada por
# Prisma para correr migraciones (prisma migrate).
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<database>?sslmode=require"

# Opcional: URL pública del sitio (usada para generar metadatos de Open Graph).
# En Vercel puedes usar la variable automática, ej: https://tu-proyecto.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
